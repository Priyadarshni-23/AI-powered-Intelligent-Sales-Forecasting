# Copy this file to .streamlit/secrets.toml and fill in the real values
# from your Google Cloud OAuth client. Never commit the real
# secrets.toml to git — add it to .gitignore.

[auth]
# Any random long string — used to encrypt the login cookie.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE_WITH_A_RANDOM_SECRET"

# Must exactly match a redirect URI registered on the Google OAuth client below.
# For local dev with `streamlit run app.py` this is:
redirect_uri = "http://localhost:8501/oauth2callback"

[auth.google]
client_id = "REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "REPLACE_WITH_YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
